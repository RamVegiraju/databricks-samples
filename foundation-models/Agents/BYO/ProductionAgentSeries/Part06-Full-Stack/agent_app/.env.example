# ── Databricks workspace ──────────────────────────────────────────────────
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
DATABRICKS_TOKEN=<your-pat-token>

# ── Agent LLM ─────────────────────────────────────────────────────────────
AGENT_LLM_ENDPOINT=databricks-claude-sonnet-4-6
AGENT_LLM_TEMPERATURE=0.1

# ── MCP Server ────────────────────────────────────────────────────────────
# URL of the deployed mcp_server/ Databricks App (step 1 of deploy order)
MCP_SERVER_URL=https://part06-mcp-server-7474655512364318.aws.databricksapps.com/mcp

# ── Lakebase (long-term memory + checkpointing) ──────────────────────────
# Run provision_lakebase.py from the Part06 root to create the instance,
# then paste the printed LAKEBASE_INSTANCE_NAME value below.
LAKEBASE_INSTANCE_NAME=<output-from-provision_lakebase.py>
DATABRICKS_EMBEDDING_ENDPOINT=databricks-bge-large-en
EMBEDDING_DIMS=1024

# ── MLflow (tracing + evaluation) ────────────────────────────────────────
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/ramvegdev@gmail.com/Part06-Full-Stack
