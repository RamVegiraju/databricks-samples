# Databricks workspace
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# OpenAI-style client (chat completions) — use your workspace URL + serving path
DATABRICKS_BASE_URL=

# Embeddings model serving endpoint name (for memory embeddings)
DATABRICKS_EMBEDDING_ENDPOINT=

# Lakebase (PostgreSQL)
LAKEBASE_INSTANCE_NAME=
LAKEBASE_HOST=
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_USER=

# Optional (defaults: LAKEBASE_PORT=5432, LAKEBASE_SSLMODE=require)
# LAKEBASE_PORT=5432
# LAKEBASE_SSLMODE=require
